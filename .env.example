# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cinema_booking
DB_USERNAME=root
DB_PASSWORD=root

# Server Configuration
SERVER_PORT=8080

# Security / JWT Configuration (Min 256 bits for HMAC-SHA256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Docker Compose Configuration (MySQL host port; backend container always uses mysql:3306)
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=cinema_booking
MYSQL_USER=cinema_user
MYSQL_PASSWORD=cinema_password

# Cloudinary (server-side credentials; never put API_SECRET into frontend code)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_POSTER_FOLDER=cinema/posters
CLOUDINARY_TIMEOUT_SECONDS=30
